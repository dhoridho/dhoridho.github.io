---
import Layout from '../layouts/Layout.astro';

// Kept in step with cv.tex by hand. The PDF stays the artefact people send on;
// this page is the version that reads on a phone and can be linked to.
const contact = [
  { label: 'dhoridhokp@gmail.com', href: 'mailto:dhoridhokp@gmail.com' },
  { label: 'linkedin.com/in/ridhokurniaputra', href: 'https://www.linkedin.com/in/ridhokurniaputra' },
  { label: 'github.com/dhoridho', href: 'https://github.com/dhoridho' },
];

const summary =
  'Backend engineer building and operating ERP platforms on Odoo and PostgreSQL. Responsible for the production repositories behind a national distribution network, covering custom modules and system integrations through to the database tuning and infrastructure that keeps them running under load. Comfortable owning a feature from schema design to the servers it runs on.';

const education = [
  {
    school: 'Bina Nusantara University',
    detail: 'Bachelor of Computer Science, Jakarta, Indonesia',
    period: 'Aug 2021 to Dec 2025',
    notes: ['GPA 3.70'],
  },
  {
    school: 'SMAN 78 Jakarta',
    detail: 'Mathematics and Natural Sciences, Jakarta, Indonesia',
    period: '2018 to 2021',
    notes: [],
  },
];

const experience = [
  {
    company: 'PT. Akasha Wira International, Tbk.',
    role: 'Software Engineer (Backend)',
    place: 'Jakarta, Indonesia',
    period: 'Sep 2025 to Present',
    points: [
      'Responsible for the core production repositories covering the central Odoo ERP, the distribution management systems, B2B and B2C channels, branch systems, and manufacturing.',
      'Write custom Odoo modules automating order-to-cash, procure-to-pay, and plan-to-produce workflows.',
      'Develop the Django middleware synchronising data between the ERP and the distribution management databases, and build the ERP-side integrations connecting Odoo to the Sales Force Application, Microsoft Dynamics AX, and mobile apps.',
      'Cut database CPU and query load by 80% during peak sales force traffic by caching Odoo search and read calls in Redis and redesigning the indexes behind the slowest queries.',
      'Operate a fleet of 100+ Dockerized Odoo instances with Ansible: nightly backups, rolling restarts, module upgrades, and health checks, with metrics in Prometheus and Grafana.',
      'Proposed and built a PostgreSQL high availability cluster on three bare-metal servers using Patroni, etcd, and Keepalived, with PgBouncer pooling, Redis Sentinel for sessions, and MinIO for the filestore. Failover verified on real hardware and approved for production rollout.',
    ],
  },
  {
    company: 'HashMicro',
    role: 'Freelance Developer',
    place: 'Jakarta, Indonesia (Remote)',
    period: 'Feb 2025 to Feb 2026',
    points: [
      'Implemented 50+ customisations and feature enhancements across sales, CRM, inventory, purchasing, and accounting modules using Python and PostgreSQL.',
      'Translated customer business workflows into database models and Python services, identifying and resolving database lock and query bottlenecks in legacy code.',
    ],
  },
  {
    company: 'HashMicro',
    role: 'Enterprise Resource Planning Developer, Internship',
    place: 'Jakarta, Indonesia (Remote)',
    period: 'Feb 2024 to Feb 2025',
    points: [
      'Built custom backend logic in Python and interface layouts in XML, delivering ERP customisations against fixed project deadlines.',
      'Ran system integration testing and mapped Functional Requirement Documents to backend implementation.',
    ],
  },
];

const projects = [
  {
    name: 'Odoo HA Stack',
    stack: 'PostgreSQL, Patroni, etcd, Keepalived, Docker Swarm, Traefik, Redis Sentinel, MinIO, Prometheus',
    href: 'https://github.com/dhoridho/odoo-ha-stack',
    points: [
      'Documented reference architecture for high availability Odoo 16 across three on-premise servers, with automatic database failover, a floating VIP, shared sessions, and zero-downtime rolling restarts. No cloud or managed services.',
    ],
  },
  {
    name: 'Ansible Odoo Automation',
    stack: 'Ansible, Docker, PostgreSQL, Prometheus, Grafana',
    href: 'https://github.com/dhoridho/ansible-odoo-automation',
    points: [
      'Playbooks operating a fleet of Dockerized Odoo instances: parallel async backups, rolling restarts, git pull with module upgrades, health checks, and Discord alerting batched per server.',
    ],
  },
];

const skills = [
  { label: 'Languages', items: 'Python, SQL, JavaScript, XML' },
  { label: 'Backend', items: 'Odoo, Django, REST APIs, XML-RPC, ERP Integration' },
  { label: 'Databases', items: 'PostgreSQL, Redis, query tuning, index design, replication, PgBouncer' },
  { label: 'Infrastructure', items: 'Docker, Docker Compose, Docker Swarm, Ansible, Linux, Git' },
  { label: 'Monitoring', items: 'Prometheus, Grafana, Loki, Alertmanager' },
];
---

<Layout
  title="CV, Ridho Kurnia Putra"
  description="Curriculum vitae of Ridho Kurnia Putra, backend engineer working on Odoo ERP platforms, PostgreSQL, and the infrastructure underneath them."
>
  <div class="page">
    <div class="bar">
      <a class="back" href="/">Ridho Kurnia Putra</a>
      <a class="download" href="/ridho-kurnia-putra-cv.pdf" download>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Download PDF
      </a>
    </div>

    <article class="sheet">
    <header class="head">
      <h1>Ridho Kurnia Putra</h1>

      <ul class="contact">
        {
          contact.map((c) => (
            <li>
              <a href={c.href} target={c.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener noreferrer">
                {c.label}
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <section>
      <h2>Summary</h2>
      <p class="summary">{summary}</p>
    </section>

    <section>
      <h2>Education</h2>
      {
        education.map((e) => (
          <article class="entry">
            <div class="entry__head">
              <h3>{e.school}</h3>
              <span>{e.period}</span>
            </div>
            <p class="entry__sub">{e.detail}</p>
            {e.notes.length > 0 && (
              <ul class="points">
                {e.notes.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </section>

    <section>
      <h2>Work Experience</h2>
      {
        experience.map((x) => (
          <article class="entry">
            <div class="entry__head">
              <h3>{x.company}</h3>
              <span>{x.period}</span>
            </div>
            <p class="entry__sub">
              {x.role} · {x.place}
            </p>
            <ul class="points">
              {x.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section>
      <h2>Projects</h2>
      {
        projects.map((p) => (
          <article class="entry">
            <div class="entry__head">
              <h3>
                <a href={p.href} target="_blank" rel="noopener noreferrer">
                  {p.name}
                </a>
              </h3>
            </div>
            <p class="entry__sub">{p.stack}</p>
            <ul class="points">
              {p.points.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    </article>

  </div>
</Layout>

<style>
  .page {
    max-width: 58rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  /* Controls live on the dark page, never on the sheet. */
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }


  .back {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--color-fg-soft);
    text-decoration: none;
  }
  .back::before {
    content: '\2190 ';
  }
  .back:hover {
    color: var(--color-fg);
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: 0.375rem;
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--color-fg);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }
  .download:hover {
    border-color: #3a3a43;
    background: #1b1b20;
  }

  /* The sheet itself: letter proportions, print margins, and the typeface the
     PDF is set in, so the page and the download are recognisably the same document. */
  .sheet {
    display: block;
    padding: 3.5rem 3.25rem 4rem;
    background: #ffffff;
    color: #111111;
    border-radius: 2px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.4),
      0 12px 40px rgb(0 0 0 / 0.45);
    font-family: 'Times New Roman', Times, serif;
    font-size: 15px;
    line-height: 1.5;
  }

  .head h1 {
    margin: 0;
    font-family: inherit;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0;
    text-align: center;
    color: inherit;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-family: inherit;
    font-size: 0.875rem;
  }

  .contact a {
    color: #111111;
    text-decoration: none;
  }
  .contact a:hover {
    text-decoration: underline;
  }

  section {
    margin-top: 1.5rem;
  }

  h2 {
    margin: 0 0 0.5rem;
    padding-bottom: 1px;
    border-bottom: 1px solid #111111;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: inherit;
  }

  .summary {
    margin: 0;
    max-width: none;
    line-height: 1.45;
    color: inherit;
  }

  .entry + .entry {
    margin-top: 0.85rem;
  }

  .entry__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .entry__head h3 {
    margin: 0;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 700;
  }

  .entry__head h3 a {
    color: inherit;
  }

  .entry__head span {
    font-family: inherit;
    font-size: 0.9375rem;
    color: inherit;
  }

  .entry__sub {
    margin: 0;
    font-family: inherit;
    font-size: 0.9375rem;
    font-style: italic;
    color: inherit;
  }

  .points {
    display: block;
    max-width: none;
    margin: 0.3rem 0 0;
    padding-left: 1.15rem;
    list-style: disc;
    line-height: 1.45;
    color: inherit;
  }

  .points li {
    position: static;
    padding: 0;
    margin-bottom: 0.15rem;
  }

  .points li::before {
    content: none;
  }

  .skills {
    margin: 0;
  }

  .skills > div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.5rem;
    padding: 0.1rem 0;
  }

  .skills > div + div {
    border-top: 0;
  }

  .skills dt {
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    color: inherit;
  }

  .skills dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  @media (max-width: 700px) {
    .page {
      padding-inline: 0.75rem;
    }

    .sheet {
      padding: 2rem 1.5rem 2.5rem;
      font-size: 14px;
    }

    .head h1 {
      font-size: 1.5rem;
    }

    .skills > div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  /* Printing this page should produce the sheet, not the dark chrome around it. */
  @media print {
    .bar {
      display: none;
    }
    .sheet {
      box-shadow: none;
      padding: 0;
    }
  }
</style>
