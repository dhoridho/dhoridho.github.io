---

<aside class="sidebar">
  <div class="sidebar__inner">
    <div>
      <h1 class="sidebar__name">Ridho<br />Kurnia Putra</h1>
      <p class="sidebar__role">
        Software Engineer, Backend<br />
        Akasha Wira International<br />
        Jakarta, Indonesia
      </p>
    </div>

    <nav class="sidebar__nav" aria-label="Sections">
      <ul>
        {
          sections.map((section) => (
            <li>
              <a href={`#${section.id}`} data-nav={section.id}>
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="sidebar__links">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith('mailto:') ? undefined : '_blank'}
              rel="noopener noreferrer"
              aria-label={link.label}
              title={link.label}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d={link.path} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<style>
  .sidebar__inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding: 3rem 2.5rem 3rem 0;
  }

  .sidebar__name {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .sidebar__role {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-fg-soft);
  }

  .sidebar__nav ul,
  .sidebar__links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: 0.875rem;
  }

  .sidebar__nav a {
    color: var(--color-fg-soft);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .sidebar__nav a:hover,
  .sidebar__nav a[data-current] {
    color: var(--color-fg);
  }


  .sidebar__links {
    flex-direction: row;
    gap: 1rem;
  }

  .sidebar__links a {
    display: block;
    color: var(--color-fg-soft);
    transition: color 160ms ease;
  }

  .sidebar__links a:hover {
    color: var(--color-accent);
  }

  /* Desktop: the column stops scrolling once it reaches the top. */
  @media (min-width: 900px) {
    .sidebar {
      position: sticky;
      top: 0;
      align-self: start;
      height: 100vh;
    }

    .sidebar__inner {
      height: 100%;
      gap: 2rem;
      padding-block: 4rem;
    }

    /* Contact sits at the bottom, everything else groups at the top. */
    .sidebar__links {
      margin-top: auto;
    }

    .sidebar__name {
      font-size: 2.25rem;
    }
  }

  @media (max-width: 899px) {
    .sidebar__inner {
      padding: 3rem 0 2rem;
      gap: 2rem;
    }

    .sidebar__nav {
      display: none;
    }
  }
</style>

<script>
  // Mark the section currently in view, so the reader always knows where they are.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const targets = Array.from(links)
    .map((link) => document.getElementById(link.dataset.nav!))
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) {
            link.toggleAttribute('data-current', link.dataset.nav === entry.target.id);
          }
        }
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );

    for (const target of targets) observer.observe(target);
  }
</script>
