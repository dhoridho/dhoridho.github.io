---
import { iconFor } from '../lib/icons';

interface Props {
  label: string;
  large?: boolean;
}

const { label, large = false } = Astro.props;
const icon = iconFor(label);
const size = large ? 16 : 12;
---

<span class="badge" data-large={large ? '' : undefined}>
  {
    icon && (
      <svg viewBox="0 0 24 24" width={size} height={size} fill={icon.hex} aria-hidden="true">
        <path d={icon.path} />
      </svg>
    )
  }
  {label}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    background: var(--color-bg);
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--color-fg-soft);
    white-space: nowrap;
  }

  .badge svg {
    flex-shrink: 0;
  }

  /* Used in the Stack section, where the logos are the point rather than a footnote. */
  .badge[data-large] {
    gap: 0.5rem;
    padding: 0.4rem 0.7rem;
    font-size: 0.8125rem;
    color: var(--color-fg);
  }
</style>
