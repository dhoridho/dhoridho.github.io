---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Badge from './Badge.astro';
import Chart from './Chart.astro';
import { iconFor } from '../lib/icons';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, context, year, stack, visibility, repo, chart } = entry.data;
const { Content } = await render(entry);
const github = iconFor('github');
---

<dialog id={`d-${entry.id}`} class="dialog" aria-labelledby={`t-${entry.id}`}>
  <form method="dialog" class="dialog__close">
    <button aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </form>

  <div class="dialog__body">
    <p class="meta">
      {year}
      <span aria-hidden="true">·</span>
      {context}
      {visibility === 'public' && <span class="meta__open">public</span>}
    </p>

    <div class="head">
      <h2 id={`t-${entry.id}`}>{title}</h2>

      <div class="head__actions">
        <a class="action" href={`/work/${entry.id}/`}>Open as page</a>
        {
          repo && (
            <a class="action" href={repo} target="_blank" rel="noopener noreferrer">
              {github && (
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                  <path d={github.path} />
                </svg>
              )}
              GitHub
            </a>
          )
        }
      </div>
    </div>

    <p class="summary">{summary}</p>

    <ul class="stack">
      {stack.map((tech) => <li><Badge label={tech} /></li>)}
    </ul>

    {chart && <Chart points={chart.points} caption={chart.caption} annotate={chart.annotate} />}

    <article class="prose">
      <Content />
    </article>

  </div>
</dialog>

<style>
  .dialog {
    /* Centred in the viewport rather than pinned to the top, the way Notion does it. */
    margin: auto;
    width: min(46rem, calc(100vw - 2rem));
    max-height: min(82vh, 54rem);
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-bg);
    color: var(--color-fg);
    overflow: hidden;
  }

  .dialog::backdrop {
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(3px);
  }

  .dialog[open] {
    animation: rise 180ms cubic-bezier(0.2, 0, 0.2, 1);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.99);
    }
  }

  .dialog__close {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    padding: 0.75rem 0.75rem 0;
    background: linear-gradient(var(--color-bg) 70%, transparent);
  }

  .dialog__close button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-line);
    border-radius: 0.375rem;
    background: var(--color-surface);
    color: var(--color-fg-soft);
    cursor: pointer;
  }

  .dialog__close button:hover {
    color: var(--color-fg);
  }

  .dialog__body {
    max-height: inherit;
    padding: 0 2rem 2rem;
    overflow-y: auto;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg-soft);
  }

  .meta__open {
    color: var(--color-accent);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-accent);
  }

  .head__actions {
    display: flex;
    flex-shrink: 0;
    gap: 0.4rem;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 0.375rem;
    background: var(--color-surface);
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--color-fg);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 160ms ease;
  }

  .action:hover {
    border-color: #3a3a43;
  }

  .summary {
    margin: 0.85rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-fg-soft);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .prose {
    margin-top: 2rem;
  }

  .prose :global(h2) {
    margin: 2rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin: 0 0 1rem;
    line-height: 1.7;
    color: var(--color-fg-soft);
  }

  .prose :global(ul) {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .prose :global(li) {
    position: relative;
    margin-bottom: 0.5rem;
    padding-left: 1rem;
    line-height: 1.65;
    color: var(--color-fg-soft);
  }

  .prose :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.35rem;
    height: 1px;
    background: var(--color-fg-soft);
  }

  .prose :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }

  .prose :global(code) {
    font-family: var(--font-ui);
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    border: 1px solid var(--color-line);
    border-radius: 3px;
    background: var(--color-surface);
  }

  @media (max-width: 640px) {
    .dialog__body {
      padding: 0 1.25rem 1.5rem;
    }
  }
</style>
