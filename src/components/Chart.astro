---
interface Props {
  points: { label: string; value: number }[];
  caption?: string;
  annotate?: string;
}

const { points, caption, annotate } = Astro.props;

const W = 640;
const H = 240;
const PAD = { top: 20, right: 16, bottom: 32, left: 52 };

const values = points.map((p) => p.value);
const max = Math.max(...values);
// Round the ceiling up to a clean number, so the axis reads as data rather than as a fit.
const step = Math.pow(10, Math.floor(Math.log10(max)));
const ceiling = Math.ceil(max / step) * step;

const innerW = W - PAD.left - PAD.right;
const innerH = H - PAD.top - PAD.bottom;

const x = (i: number) => PAD.left + (i / Math.max(points.length - 1, 1)) * innerW;
const y = (v: number) => PAD.top + innerH - (v / ceiling) * innerH;

const line = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(' ');
const area = `${line} L${x(points.length - 1).toFixed(1)},${PAD.top + innerH} L${x(0).toFixed(1)},${PAD.top + innerH} Z`;

const ticks = [0, ceiling / 2, ceiling];
const compact = (v: number) =>
  v >= 1000 ? `${(v / 1000).toFixed(v >= 100000 ? 0 : 1)}k` : String(v);
const marked = annotate ? points.findIndex((p) => p.label === annotate) : -1;
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={caption}>
    {
      ticks.map((t) => (
        <>
          <line class="grid" x1={PAD.left} y1={y(t)} x2={W - PAD.right} y2={y(t)} />
          <text class="tick" x={PAD.left - 8} y={y(t)} text-anchor="end" dominant-baseline="middle">
            {compact(t)}
          </text>
        </>
      ))
    }

    <path class="area" d={area} />
    <path class="line" d={line} />

    {
      points.map((p, i) => (
        <circle class="dot" data-marked={i === marked ? '' : undefined} cx={x(i)} cy={y(p.value)} r={i === marked ? 4 : 3} />
      ))
    }

    {
      points.map((p, i) => (
        <text
          class="value"
          x={x(i)}
          y={y(p.value) - 12}
          text-anchor={i === 0 ? 'start' : i === points.length - 1 ? 'end' : 'middle'}
        >
          {compact(p.value)}
        </text>
      ))
    }

    {
      points.map((p, i) => (
        <text class="label" x={x(i)} y={H - 10} text-anchor="middle">
          {p.label}
        </text>
      ))
    }
  </svg>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .chart {
    margin: 1.5rem 0 2rem;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .grid {
    stroke: var(--color-line);
    stroke-width: 1;
  }

  .line {
    fill: none;
    stroke: var(--color-fg);
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .area {
    fill: var(--color-fg);
    opacity: 0.06;
  }

  .dot {
    fill: var(--color-bg);
    stroke: var(--color-fg);
    stroke-width: 1.8;
  }

  .dot[data-marked] {
    fill: var(--color-fg);
  }

  .tick,
  .label {
    font-family: var(--font-ui);
    font-size: 10px;
    fill: var(--color-fg-soft);
  }

  .value {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 500;
    fill: var(--color-fg);
  }

  figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-fg-soft);
  }
</style>
