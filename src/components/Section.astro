---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="section">
  <h2 class="section__title">{title}</h2>
  <slot />
</section>

<style>
  .section {
    padding-block: 2.5rem;
  }

  .section:first-of-type {
    padding-top: 0;
  }

  .section__title {
    position: relative;
    margin: 0 0 1.25rem;
    padding-left: 0.9rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section__title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 3px;
    height: 0.75em;
    background: var(--color-fg-soft);
    border-radius: 1px;
  }
</style>
